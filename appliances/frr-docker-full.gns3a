{
    "appliance_id": "6a5ddb04-b890-4904-a64a-ea4c5a671ec4",
    "name": "FRR (Docker) Full",
    "category": "router",
    "symbol": "router.svg",
    "description": "FRRouting (FRR) is an IP routing protocol suite for Linux and Unix platforms which includes protocol daemons for BGP, IS-IS, LDP, OSPF, PIM, and RIP.\n\nThis is the full-protocol Docker variant: it runs the complete FRR suite — BGP, OSPFv2/v3, RIP/RIPng, IS-IS, LDP, PIM/PIM6, NHRP, EIGRP, Babel, BFD, VRRP, PBR and static routing — for complex, multi-protocol topologies.",
    "vendor_name": "FRRouting Project",
    "vendor_url": "https://frrouting.org",
    "documentation_url": "https://docs.frrouting.org/",
    "product_name": "FRR",
    "registry_version": 4,
    "status": "experimental",
    "availability": "free",
    "maintainer": "GNS3 Team",
    "maintainer_email": "developers@gns3.net",
    "usage": "Full-protocol variant. The console opens directly in the FRR CLI (vtysh). Type 'exit' to reach a Linux shell; run 'vtysh' to return. Save your config with 'write memory'.",
    "docker": {
        "adapters": 8,
        "image": "gns3/frr:latest",
        "console_type": "telnet",
        "start_command": "/usr/lib/frr/docker-start",
        "environment": "FRR_PROFILE=full,\nTERM=xterm"
    }
}
