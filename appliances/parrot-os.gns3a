    "registry_version": 8,
    "status": "stable",
    "maintainer": "Brent Stewart",
    "maintainer_email": "brent@stewart.tc",
    "usage": "Passwords are set during installation.",
    "symbol": "parrotlogo.png",
    "settings": [
        {
            "name": "default",
            "default": true,
            "template_type": "qemu",
            "template_properties": {
