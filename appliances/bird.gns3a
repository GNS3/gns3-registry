{
    "appliance_id": "8fecbf89-5cd1-4aea-b735-5f36cf0efbb7",
    "name": "BIRD",
    "category": "router",
    "description": "The BIRD project aims to develop a fully functional dynamic IP routing daemon primarily targeted on (but not limited to) Linux, FreeBSD and other UNIX-like systems and distributed under the GNU General Public License.",
    "vendor_name": "CZ.NIC Labs",
    "vendor_url": "https://bird.network.cz",
    "documentation_url": "https://bird.network.cz/?get_doc&f=bird.html&v=20",
    "product_name": "BIRD internet routing daemon",
    "registry_version": 8,
    "status": "stable",
    "maintainer": "GNS3 Team",
    "maintainer_email": "developers@gns3.net",
    "usage": "To become root, use 'sudo -s'.\n\nNetwork configuration:\nsudo nano /etc/network/interfaces\nsudo systemctl restart networking\n\nBIRD:\nRestart: sudo systemctl restart bird\nReconfigure: birdc configure",
    "default_username": "gns3",
    "default_password": "gns3",
    "settings": [
        {
            "name": "default",
            "default": true,
            "template_type": "qemu",
            "template_properties": {
                "platform": "x86_64",
                "port_name_format": "eth{0}",
                "adapter_type": "virtio-net-pci",
                "adapters": 4,
                "ram": 256,
                "hda_disk_interface": "virtio",
                "console_type": "telnet"
            }
        },
        {
            "name": "arm64",
            "template_type": "qemu",
            "template_properties": {
                "platform": "aarch64",
                "uefi": true
            }
        }
    ],
    "images": [
