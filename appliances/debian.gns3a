    "product_name": "Debian",
    "registry_version": 8,
    "status": "stable",
    "maintainer": "GNS3 Team",
    "maintainer_email": "developers@gns3.net",
    "usage": "Username:\tdebian\nPassword:\tdebian\nTo become root, use \"sudo -s\".\n",
    "default_username": "debian",
    "default_password": "debian",
    "settings": [
        {
            "name": "default",
            "default": true,
            "template_type": "qemu",
            "template_properties": {
                "platform": "x86_64",
                "port_name_format": "Ethernet{0}",
                "adapter_type": "virtio-net-pci",
                "adapters": 1,
                "ram": 256,
                "hda_disk_interface": "virtio",
                "console_type": "telnet"
            }
        },
        {
            "name": "arm64",
            "template_type": "qemu",
            "template_properties": {
                "platform": "aarch64",
                "uefi": true
            }
        }
    ],
