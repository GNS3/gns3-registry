    "settings": [
        {
            "name": "default",
            "default": true,
            "template_type": "qemu",
            "template_properties": {
                "platform": "x86_64",
                "port_name_format": "Ethernet{0}",
                "adapter_type": "virtio-net-pci",
                "adapters": 1,
                "ram": 1024,
                "hda_disk_interface": "virtio",
                "console_type": "telnet"
            }
        },
        {
            "name": "aarch64",
            "template_type": "qemu",
            "template_properties": {
                "platform": "aarch64",
                "uefi": true
            }
        }
    ],
